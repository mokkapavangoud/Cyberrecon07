# CyberRecon configuration. Copy to backend/.env (or export as environment variables).
# Every setting uses the CYBERRECON_ prefix. Nothing here is a real secret; never commit a real .env.

CYBERRECON_ENVIRONMENT=development

# --- storage ---------------------------------------------------------------
# SQLite file, report PDFs and screenshots live under this directory.
CYBERRECON_DATA_DIR=./data
# CYBERRECON_DATABASE_URL=sqlite:////absolute/path/cyberrecon.db

# --- web -------------------------------------------------------------------
# Comma-separated list of origins allowed by CORS (only needed when the UI is served from another origin, e.g. the Vite dev server).
CYBERRECON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-client-IP requests per minute on expensive endpoints (per process, in memory).
CYBERRECON_RATE_LIMIT_PER_MINUTE=30
# Built SPA directory. Defaults to ../frontend/dist when it exists.
# CYBERRECON_FRONTEND_DIST=/app/frontend/dist

# --- outbound network controls --------------------------------------------
CYBERRECON_HTTP_CONNECT_TIMEOUT=5
CYBERRECON_HTTP_READ_TIMEOUT=10
CYBERRECON_HTTP_TOTAL_TIMEOUT=25
CYBERRECON_MAX_RESPONSE_BYTES=2000000
CYBERRECON_MAX_REDIRECTS=5
CYBERRECON_ALLOWED_PORTS=80,443,8080,8443
CYBERRECON_MAX_CONCURRENT_ASSESSMENTS=3
# Optional: restrict live assessments to these domains (and their subdomains). Strongly recommended for shared deployments.
# CYBERRECON_TARGET_ALLOWLIST=example.org,my-company.com

# --- link analysis ---------------------------------------------------------
CYBERRECON_LINK_CHECK_DEFAULT_LIMIT=25
CYBERRECON_LINK_CHECK_MAX_LIMIT=100
CYBERRECON_LINK_CHECK_CONCURRENCY=4

# --- image intelligence ----------------------------------------------------
CYBERRECON_MAX_UPLOAD_BYTES=10485760
CYBERRECON_MAX_IMAGE_PIXELS=50000000
# GPS coordinates are redacted before saving unless this is true. Leave false unless you understand the privacy cost.
CYBERRECON_PERSIST_IMAGE_GPS=false

# --- DNS -------------------------------------------------------------------
# Comma-separated resolver IPs. Empty = use the system resolver.
# CYBERRECON_DNS_RESOLVERS=1.1.1.1,9.9.9.9
CYBERRECON_DNS_TIMEOUT=4

# --- optional providers ----------------------------------------------------
# crtsh (public Certificate Transparency search, no key) | securitytrails (needs a key) | none
CYBERRECON_SUBDOMAIN_PROVIDER=crtsh
# Server-side only. Never exposed to the browser.
# CYBERRECON_SECURITYTRAILS_API_KEY=
# none | ipapi | maxmind  (maxmind needs a local GeoLite2/GeoIP2 City .mmdb file you have licensed)
CYBERRECON_GEOIP_PROVIDER=none
# CYBERRECON_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# --- screenshots -----------------------------------------------------------
CYBERRECON_SCREENSHOT_ENABLED=true
CYBERRECON_SCREENSHOT_TIMEOUT_MS=20000
# Strongly recommended in production: route Chromium through an egress proxy that enforces the same IP policy.
# CYBERRECON_SCREENSHOT_PROXY=http://egress-proxy:3128
# CYBERRECON_CHROMIUM_PATH=/usr/bin/chromium
